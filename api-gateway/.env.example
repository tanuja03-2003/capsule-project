# API Gateway Configuration
PORT=8000
NODE_ENV=development

# Downstream Microservices (Use Docker service names in containers, localhost for local development)
EVENT_SERVICE_URL=http://localhost:3000
BOOKING_SERVICE_URL=http://localhost:3000
PAYMENT_SERVICE_URL=http://localhost:3002
VENUE_ACCESS_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3003

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Downstream Timeout (milliseconds)
GATEWAY_TIMEOUT_MS=10000
